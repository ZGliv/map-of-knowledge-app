{
 "summary": [
  {
   "text": "Activation energy is the minimum energy barrier that reactant molecules must overcome to turn into products.",
   "cites": [
    1
   ]
  },
  {
   "text": "A reaction occurs only if enough molecules have kinetic energy equal to or above that barrier, which usually needs a sufficiently high temperature.",
   "cites": [
    2
   ]
  },
  {
   "text": "A catalyst lowers the barrier without changing the energies of the reactants or products, so it speeds the reaction up without shifting the equilibrium.",
   "cites": [
    12,
    13,
    14
   ]
  }
 ],
 "facts": [
  {
   "label": "Term introduced",
   "value": "By Svante Arrhenius in 1889",
   "cites": [
    3
   ]
  },
  {
   "label": "Also applies to",
   "value": "Nuclear reactions and other physical phenomena",
   "cites": [
    4
   ]
  },
  {
   "label": "Arrhenius equation",
   "value": "k = A exp(−Ea/RT)",
   "cites": [
    27
   ]
  },
  {
   "label": "Eyring equation uses",
   "value": "Gibbs energy of activation instead of Ea",
   "cites": [
