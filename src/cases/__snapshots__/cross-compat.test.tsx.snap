exports[`one-gene crosses stay exactly as they were > genetics-dna “Spin the copies”: the pea-cross checks and questions 1`] = `"[{"gradeId":"first-round","prompt":"The bacteria divide once in light nitrogen, so their DNA is copied once. Where will the copies settle in the spinning tube?","choices":[{"id":"two","label":"Half at the heavy mark, half at the light mark","feedback":"That would happen if the old molecule stayed whole and a brand-new one were built beside it. The tube showed no heavy band at all."},{"id":"light","label":"All at the light mark","feedback":"The old heavy strands don’t vanish. Each one is still there, inside a copy, paired with a new light strand."},{"id":"mid","label":"All in one band, halfway between"},{"id":"heavy","label":"All at the heavy mark","feedback":"After one round, half of all the DNA is newly built from light nitrogen, so it can’t all sit at the heavy mark."}],"answer":"mid"},{"gradeId":"second-round","prompt":"Let those hybrid molecules copy once more in light nitrogen. What will the tube show now?","choices":[{"id":"shift","label":"One band again, a little lighter than before","feedback":"That is what mixing old and new pieces along every strand would give. Instead each strand stays whole and gets a new light partner, so the light strands made in the first round give fully light copies: a second, light band appears."},{"id":"split","label":"Equal bands: one hybrid, one light"},{"id":"three","label":"Heavy, hybrid and light, one to two to one","feedback":"A heavy copy needs two heavy strands, and every new strand here is light. No heavy molecule can form."},{"id":"same","label":"One hybrid band, as before","feedback":"Half the old strands are light now. A copy built on a light strand is light on both sides."}],"answer":"split"}]"`;

exports[`one-gene crosses stay exactly as they were > genetics-dna “Spin the copies”: the pea-cross sim as it opens 1`] = `"<section class="beat beat--wide"><h2 class="beat__heading">Spin the copies</h2><p class="goal">Bacteria grown for many generations on heavy nitrogen have heavy DNA. Move them to ordinary, light nitrogen and let them divide: every new strand is now built light. Predict where the copies settle in a spinning tube of dense salt, where heavier DNA sinks lower, then spin them. Each dot is one molecule from the tube.</p><div class="peacross"><div class="peacross__step"><h3 class="peacross__title">Copy once in light nitrogen</h3><div class="question"><p class="question__prompt">The bacteria divide once in light nitrogen, so their DNA is copied once. Where will the copies settle in the spinning tube?</p><div class="choices" role="radiogroup"><button type="button" role="radio" aria-checked="false" class="choice choice--idle">Half at the heavy mark, half at the light mark</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">All at the light mark</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">All in one band, halfway between</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">All at the heavy mark</button></div></div></div></div></section>"`;

exports[`one-gene crosses stay exactly as they were > genetics-dominance c_4bckeyfa2m: answer, run, line and policing 1`] = `"{"run":{"engine":"cross","expectedShare":0.5,"brood":["AB","BB","BB","BB","AB","BB","BB","AB","BB","BB","AB","BB","AB","AB","AB","BB","AB","AB","BB","AB","AB","BB","AB","AB","BB","AB","AB","AB","BB","AB","BB","AB","AB","BB","BB","BB","BB","AB","AB","BB","BB","BB","BB","BB","BB","AB","BB","BB","AB","BB","BB","AB","AB","BB","BB","AB","AB","AB","BB","BB","AB","AB","BB","BB","BB","BB","BB","AB","BB","BB","BB","BB","AB","BB","AB","BB","AB","AB","AB","BB","BB","BB","AB","BB","BB","BB","BB","AB","AB","AB","BB","AB","BB","BB","BB","BB","AB","BB","AB","AB","BB","AB","AB","AB","BB","BB","AB","BB","AB","AB","AB","AB","BB","AB","AB","AB","AB","BB","BB","AB","AB","AB","BB","BB","AB","AB","AB","AB","BB","AB","BB","AB","AB","AB","AB","BB","AB","BB","AB","BB","BB","BB","BB","AB","AB","BB","BB","BB","AB","BB","AB","BB","AB","AB","AB","AB","BB","BB","BB","BB","BB","BB","BB","BB","BB","AB","BB","AB","AB","AB","BB","BB","BB","BB","AB","BB","BB","AB","BB","BB","BB","BB","AB","AB","BB","AB","AB","AB","BB","AB","AB","BB","AB","BB","BB","BB","BB","BB","AB","AB"],"counts":{"AB":94,"B":106}},"truth":{"kind":"set","value":100},"line":"Couples in which one partner carries both markers and the other only b: both markers in half the children, about 100 of 200. This run had 94."}"`;

