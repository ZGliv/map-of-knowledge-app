exports[`one-gene crosses stay exactly as they were > evolution-e02 “Mendel’s garden”: the pea-cross checks and questions 1`] = `"[{"gradeId":"hybrid-seeds","prompt":"Both parents come from lines that always breed true. What will the seeds of the cross look like?","choices":[{"id":"between","label":"All in between: a little wrinkled","feedback":"That is what blending predicts. In each of his seven crosses, Mendel found the hybrids looked like one parent, not halfway between."},{"id":"mix","label":"Some round, some wrinkled","feedback":"Not yet. That mix turns up one generation later."},{"id":"round","label":"All round"},{"id":"wrinkled","label":"All wrinkled","feedback":"Round wins out here, not wrinkled. Mendel called the trait that shows dominant."}],"answer":"round"},{"gradeId":"self-seeds","prompt":"A pea flower pollinates itself before it even opens. Grow the round hybrid seeds and let the plants do that. What seeds will they make?","choices":[{"id":"allround","label":"All round again, just like the parent plant","feedback":"If the wrinkled factor were gone, yes. It isn’t gone, only hidden."},{"id":"three","label":"Roughly three round to one wrinkled"},{"id":"between","label":"All slightly wrinkled, in between","feedback":"Blending again. Mendel: “Transitional forms were not observed in any experiment.”"},{"id":"half","label":"Half round and half wrinkled","feedback":"Wrinkled does come back, but in about one seed of every four, not two."}],"answer":"three"}]"`;

exports[`one-gene crosses stay exactly as they were > evolution-e02 “Mendel’s garden”: the pea-cross sim as it opens 1`] = `"<section class="beat beat--wide"><h2 class="beat__heading">Mendel’s garden</h2><p class="goal">From 1856 to 1863 Gregor Mendel grew and tested some 28,000 plants in his monastery’s garden, most of them peas. Make his first cross.</p><div class="peacross"><div class="peacross__step"><h3 class="peacross__title">A round-seeded plant crossed with a wrinkled-seeded one</h3><div class="peacross__parents" aria-label="Round-seeded parent crossed with Wrinkled-seeded parent"><div class="peacross__parent"><svg class="pea pea--round" viewBox="-12 -12 24 24" width="54" height="54" aria-hidden="true"><circle r="10" class="pea__body"></circle><ellipse cx="-3.5" cy="-4" rx="3" ry="2" class="pea__shine"></ellipse></svg><span>Round-seeded parent</span></div><span class="peacross__times" aria-hidden="true">×</span><div class="peacross__parent"><svg class="pea pea--wrinkled" viewBox="-12 -12 24 24" width="54" height="54" aria-hidden="true"><path d="M-9 -2 C-10 -8 -4 -11 0 -9 C3 -11 9 -9 9 -4 C11 0 9 6 5 8 C2 11 -3 10 -6 8 C-10 6 -11 2 -9 -2 Z" class="pea__body"></path><path d="M-5 -5 C-2 -3 -3 1 -6 3 M2 -7 C0 -3 3 0 1 4 M6 -2 C4 1 6 4 3 7" class="pea__crease"></path></svg><span>Wrinkled-seeded parent</span></div></div><div class="question"><p class="question__prompt">Both parents come from lines that always breed true. What will the seeds of the cross look like?</p><div class="choices" role="radiogroup"><button type="button" role="radio" aria-checked="false" class="choice choice--idle">All in between: a little wrinkled</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">Some round, some wrinkled</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">All round</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">All wrinkled</button></div></div></div></div></section>"`;

