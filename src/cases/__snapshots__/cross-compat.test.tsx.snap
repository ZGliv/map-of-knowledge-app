`;

exports[`one-gene crosses stay exactly as they were > genetics-dominance “Breed Andalusians”: the pea-cross checks and questions 1`] = `"[{"gradeId":"first-cross","prompt":"Both birds come from lines that always breed true: black from black, white from white. What will their chicks look like?","choices":[{"id":"mix","label":"Some black chicks and some white ones","feedback":"That needs a parent carrying both versions. Each of these parents carries only one kind, so every chick gets one of each."},{"id":"black","label":"All black, because black is stronger","feedback":"Here neither version hides the other. A chick with one black-making and one white-making copy shows something new."},{"id":"blue","label":"All blue"},{"id":"grey","label":"Grey at first, turning white as they grow","feedback":"The colour is set by the copies a chick inherits. Every chick here inherits one copy of each."}],"answer":"blue"},{"gradeId":"blue-cross","prompt":"Now mate two of the blue birds. What will their chicks be?","choices":[{"id":"allblue","label":"All blue, like both parents","feedback":"If blue bred true, breeders would keep pure blue lines. Each blue bird still carries a black-making and a white-making copy, and passes on one of them at random."},{"id":"three","label":"Three blue to every one white","feedback":"Three to one is the pattern when one version hides the other. Here the black-making copy shows too, so black chicks hatch as well."},{"id":"ratio","label":"About one black to two blue to one white"},{"id":"paler","label":"Paler blue chicks, drifting towards white","feedback":"That is what blending would predict. The black and white chicks come back as black and as white as their grandparents."}],"answer":"ratio"}]"`;

exports[`one-gene crosses stay exactly as they were > genetics-dominance “Breed Andalusians”: the pea-cross sim as it opens 1`] = `"<section class="beat beat--wide"><h2 class="beat__heading">Breed Andalusians</h2><p class="goal">One gene decides whether an Andalusian’s feathers come out black, blue or white. Predict each brood, then hatch it: every chick gets one copy from each parent, picked at random.</p><div class="peacross"><div class="peacross__step"><h3 class="peacross__title">A black bird mated with a white one</h3><div class="peacross__parents" aria-label="Black hen crossed with White cock"><div class="peacross__parent"><svg class="pea pea--dot pea--full" viewBox="-12 -12 24 24" width="54" height="54" aria-hidden="true"><circle r="9.5" class="pea__ring"></circle><circle r="9.5" class="pea__fill"></circle></svg><span>Black hen</span></div><span class="peacross__times" aria-hidden="true">×</span><div class="peacross__parent"><svg class="pea pea--dot pea--none" viewBox="-12 -12 24 24" width="54" height="54" aria-hidden="true"><circle r="9.5" class="pea__ring"></circle></svg><span>White cock</span></div></div><div class="question"><p class="question__prompt">Both birds come from lines that always breed true: black from black, white from white. What will their chicks look like?</p><div class="choices" role="radiogroup"><button type="button" role="radio" aria-checked="false" class="choice choice--idle">Some black chicks and some white ones</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">All black, because black is stronger</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">All blue</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">Grey at first, turning white as they grow</button></div></div></div></div></section>"`;

exports[`one-gene crosses stay exactly as they were > genetics-meiosis “Deal the copies”: the pea-cross checks and questions 1`] = `"[{"gradeId":"one-spot","prompt":"At this spot the eldest got S from both parents. What will the younger brothers and sisters carry there?","choices":[{"id":"same","label":"All carry both S copies, like the eldest","feedback":"Every egg and every sperm is dealt afresh. The eldest’s draw doesn’t bind the next child’s."},{"id":"new","label":"None carry S: each child gets fresh copies","feedback":"Each parent has only two copies at this spot, and S is one of them. From each parent, a child gets S half the time."},{"id":"blend","label":"Each carries half of each S copy, blended","feedback":"At a single spot a copy passes whole or not at all. Sharing comes in whole copies: two, one or none."},{"id":"mix","label":"Some both, about half one, some neither"}],"answer":"mix"},{"gradeId":"half-average","prompt":"Brothers and sisters are said to share half their DNA. Raise a hundred more. In what sense do they share half at this spot?","choices":[{"id":"each","label":"Every one carries exactly one of the eldest’s two copies","feedback":"Only about half of them do. The rest carry both copies, or neither."},{"id":"average","label":"As an average: some share two, some one, some none"},{"id":"split","label":"Half match the eldest exactly and half share nothing at all","feedback":"Exact matches at this spot are only about one in four, and so are complete misses."},{"id":"mother","label":"All carry the mother’s S, and half the father’s","feedback":"The mother’s S is no surer than the father’s. Each child gets it half the time."}],"answer":"average"}]"`;

exports[`one-gene crosses stay exactly as they were > genetics-meiosis “Deal the copies”: the pea-cross sim as it opens 1`] = `"<section class="beat beat--wide"><h2 class="beat__heading">Deal the copies</h2><p class="goal">Pick one spot on chromosome 5. Each parent has two copies there and handed one to their eldest child: call it S, and the copy they kept back N. Predict, then raise younger brothers and sisters. Each gets one copy from each parent, picked at random.</p><div class="peacross"><div class="peacross__step"><h3 class="peacross__title">Twelve younger siblings</h3><div class="peacross__parents" aria-label="Mother crossed with Father"><div class="peacross__parent"><svg class="pea pea--dot pea--half" viewBox="-12 -12 24 24" width="54" height="54" aria-hidden="true"><circle r="9.5" class="pea__ring"></circle><path d="M0 -9.5 A9.5 9.5 0 0 1 0 9.5 Z" class="pea__fill"></path></svg><span>Mother</span></div><span class="peacross__times" aria-hidden="true">×</span><div class="peacross__parent"><svg class="pea pea--dot pea--half" viewBox="-12 -12 24 24" width="54" height="54" aria-hidden="true"><circle r="9.5" class="pea__ring"></circle><path d="M0 -9.5 A9.5 9.5 0 0 1 0 9.5 Z" class="pea__fill"></path></svg><span>Father</span></div></div><div class="question"><p class="question__prompt">At this spot the eldest got S from both parents. What will the younger brothers and sisters carry there?</p><div class="choices" role="radiogroup"><button type="button" role="radio" aria-checked="false" class="choice choice--idle">All carry both S copies, like the eldest</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">None carry S: each child gets fresh copies</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">Each carries half of each S copy, blended</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">Some both, about half one, some neither</button></div></div></div></div></section>"`;

exports[`one-gene crosses stay exactly as they were > genetics-sex-linked “Follow the X”: the pea-cross checks and questions 1`] = `"[{"gradeId":"carrier-mother","prompt":"This mother sees colours normally, but one of her two Xs carries a colour-blind copy. The father sees normally. Which of their children could be colour-blind?","choices":[{"id":"both","label":"Sons and daughters, about equally","feedback":"A daughter also gets her father’s X, and his works. She would need a colour-blind copy from each parent."},{"id":"sons","label":"Only sons: about half of them"},{"id":"daughters","label":"Only daughters, like their mother","feedback":"The mother isn’t colour-blind: her working copy covers for the other. Her daughters get their father’s working X as well."},{"id":"none","label":"None of them: both parents see normally","feedback":"A son has only one X, his mother’s. If he gets her colour-blind copy, nothing covers for it."}],"answer":"sons"},{"gradeId":"blind-father","prompt":"Now the father is colour-blind and the mother carries no colour-blind copy. Which of their children will carry his colour-blind copy?","choices":[{"id":"half","label":"About half the sons and half the daughters","feedback":"A father has only one X to give, so it goes to every daughter and to no son."},{"id":"sons","label":"Every son, since sons take after their father","feedback":"A son is a son because he got his father’s Y, so the father’s X never reaches him."},{"id":"none","label":"None of them: the copy dies out with him","feedback":"Every daughter gets his X. She sees normally, because her mother’s X works, but she carries his copy."},{"id":"daughters","label":"Every daughter, and no son"}],"answer":"daughters"}]"`;

exports[`one-gene crosses stay exactly as they were > genetics-sex-linked “Follow the X”: the pea-cross sim as it opens 1`] = `"<section class="beat beat--wide"><h2 class="beat__heading">Follow the X</h2><p class="goal">The genes for the eye’s red- and green-sensing pigments sit on the X chromosome. A mother passes one of her two Xs to each child. A father passes his X to each daughter and his Y to each son. Predict each family, then raise it.</p><div class="peacross"><div class="peacross__step"><h3 class="peacross__title">A carrier mother and a father who sees normally</h3><div class="peacross__parents" aria-label="Mother crossed with Father"><div class="peacross__parent"><svg class="pea pea--dot pea--full" viewBox="-12 -12 24 24" width="54" height="54" aria-hidden="true"><circle r="9.5" class="pea__ring"></circle><circle r="9.5" class="pea__fill"></circle></svg><span>Mother</span></div><span class="peacross__times" aria-hidden="true">×</span><div class="peacross__parent"><svg class="pea pea--dot pea--full" viewBox="-12 -12 24 24" width="54" height="54" aria-hidden="true"><circle r="9.5" class="pea__ring"></circle><circle r="9.5" class="pea__fill"></circle></svg><span>Father</span></div></div><div class="question"><p class="question__prompt">This mother sees colours normally, but one of her two Xs carries a colour-blind copy. The father sees normally. Which of their children could be colour-blind?</p><div class="choices" role="radiogroup"><button type="button" role="radio" aria-checked="false" class="choice choice--idle">Sons and daughters, about equally</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">Only sons: about half of them</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">Only daughters, like their mother</button><button type="button" role="radio" aria-checked="false" class="choice choice--idle">None of them: both parents see normally</button></div></div></div></div></section>"`;
